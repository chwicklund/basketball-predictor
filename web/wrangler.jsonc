{
	"$schema": "node_modules/wrangler/config-schema.json",
	// One Worker serves the React build (dist/), the admin API and the wager job.
	"name": "hoops-predictor",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"triggers": {
		"crons": [
			// Wagers: every 10 minutes from noon US Eastern to late evening (16:00-03:59 UTC covers daylight and
			// standard time). worker/schedule.js waits for today's slot (12:10 or 5:10 p.m.), then wagers each
			// game once, as soon as the day's predictions are deployed and before that game tips off.
			"*/10 16-23 * * *",
			"*/10 0-3 * * *",
			// Settle yesterday's wagers after the games are final.
			"15 10 * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hoops-predictor",
			"database_id": "b64edb60-fd95-461a-8d22-c3d211247421"
		}
	],
	"vars": {
		"KALSHI_BASE": "https://api.elections.kalshi.com/trade-api/v2"
	}
}